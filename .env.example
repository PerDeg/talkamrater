# ---------- Talkamrater ----------
# Kopiera till .env och fyll i. Alla värden kan också sättas som
# miljövariabler i Unraid-mallen för containern.

# Nyckel till lärarsidan (/admin.html). Välj en lång slumpmässig sträng.
ADMIN_KEY=byt-mig-till-nagot-langt-och-hemligt

# Port i containern
PORT=3000

# ---------- Databas ("connectorn") ----------
# DB_CLIENT: postgres | mysql | mariadb | sqlite
DB_CLIENT=postgres

# Antingen en hel adress …
DATABASE_URL=postgres://talkamrater:losenord@192.168.1.10:5432/talkamrater
#   MySQL/MariaDB: mysql://talkamrater:losenord@192.168.1.10:3306/talkamrater

# … eller delarna var för sig (används om DATABASE_URL är tom)
# DB_HOST=192.168.1.10
# DB_PORT=5432
# DB_USER=talkamrater
# DB_PASSWORD=losenord
# DB_NAME=talkamrater
# DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true

# Prefix på tabellerna, så att de inte krockar med annat i en befintlig databas
DB_TABLE_PREFIX=tk_

# Max antal samtidiga databasanslutningar
DB_POOL_MAX=5

# Bara för DB_CLIENT=sqlite: var filen ska ligga
# SQLITE_FILE=/data/talkamrater.db

# Vilka proxyservrar som får skicka X-Forwarded-For (nginx).
# Standard räcker när nginx kör på samma maskin eller i ett lokalt nät.
# TRUST_PROXY=loopback, linklocal, uniquelocal
